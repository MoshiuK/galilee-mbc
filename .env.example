# =============================================================================
# WhiteLabel PBX - Environment Configuration
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/whitelabel_pbx?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# SignalWire Credentials (Platform-level)
SIGNALWIRE_PROJECT_ID=your-signalwire-project-id
SIGNALWIRE_API_TOKEN=your-signalwire-api-token
SIGNALWIRE_SPACE_URL=your-space.signalwire.com

# Webhook Base URL (publicly accessible URL for SignalWire callbacks)
WEBHOOK_BASE_URL=https://your-domain.com/api/webhooks/signalwire

# Platform Admin (initial setup)
PLATFORM_ADMIN_EMAIL=admin@yourplatform.com
PLATFORM_ADMIN_PASSWORD=change-this-password

# Redis (optional, for caching/sessions)
REDIS_URL=redis://localhost:6379

# File Storage (voicemail recordings, etc.)
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=info
