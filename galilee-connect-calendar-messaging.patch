+-- Church Calendar Events
+CREATE TABLE IF NOT EXISTS calendar_events (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    title TEXT NOT NULL,
+    description TEXT,
+    event_date TEXT NOT NULL,       -- YYYY-MM-DD
+    start_time TEXT,                -- HH:MM (24hr)
+    end_time TEXT,                  -- HH:MM (24hr)
+    location TEXT DEFAULT 'Galilee MBC',
+    category TEXT DEFAULT 'general', -- worship, bible-study, youth, fellowship, meeting, general
+    is_recurring INTEGER DEFAULT 0,
+    created_at TEXT DEFAULT (datetime('now')),
+    updated_at TEXT DEFAULT (datetime('now'))
+);
+
+CREATE INDEX IF NOT EXISTS idx_calendar_date ON calendar_events(event_date);
+CREATE INDEX IF NOT EXISTS idx_calendar_category ON calendar_events(category);
+
+-- Church Messaging (admin-to-member direct messages, distinct from notification message_log)
+CREATE TABLE IF NOT EXISTS church_messages (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    sender_name TEXT NOT NULL,       -- admin username who sent
+    recipient_id INTEGER,            -- member id (NULL = broadcast)
+    recipient_name TEXT,             -- denormalized for display
+    subject TEXT NOT NULL,
+    body TEXT NOT NULL,
+    channel TEXT DEFAULT 'internal', -- internal, email, sms
+    is_read INTEGER DEFAULT 0,
+    is_broadcast INTEGER DEFAULT 0,
+    created_at TEXT DEFAULT (datetime('now')),
+    FOREIGN KEY (recipient_id) REFERENCES members(id) ON DELETE SET NULL
+);
+
+CREATE INDEX IF NOT EXISTS idx_church_messages_recipient ON church_messages(recipient_id);
+CREATE INDEX IF NOT EXISTS idx_church_messages_date ON church_messages(created_at);
+
