+// ==================== CALENDAR API ====================
+
+// List calendar events (with optional month filter)
+router.get('/calendar', requireAuth, (req, res) => {
+    const db = getDb();
+    const year = parseInt(req.query.year) || new Date().getFullYear();
+    const month = parseInt(req.query.month) || (new Date().getMonth() + 1);
+
+    const startDate = `${year}-${String(month).padStart(2, '0')}-01`;
+    const endMonth = month === 12 ? 1 : month + 1;
+    const endYear = month === 12 ? year + 1 : year;
+    const endDate = `${endYear}-${String(endMonth).padStart(2, '0')}-01`;
+
+    const events = db.prepare(
+        'SELECT * FROM calendar_events WHERE event_date >= ? AND event_date < ? ORDER BY event_date, start_time'
+    ).all(startDate, endDate);
+
+    res.json({ success: true, events, year, month });
+});
+
+// Get single event
+router.get('/calendar/:id', requireAuth, (req, res) => {
+    const db = getDb();
+    const event = db.prepare('SELECT * FROM calendar_events WHERE id = ?').get(req.params.id);
+    if (!event) {
+        return res.status(404).json({ error: 'Event not found' });
+    }
+    res.json({ success: true, event });
+});
+
+// Create event
+router.post('/calendar', requireAuth, (req, res) => {
+    const { title, description, event_date, start_time, end_time, location, category } = req.body;
+
+    if (!title || !event_date) {
+        return res.status(400).json({ error: 'Title and date are required' });
+    }
+
+    const db = getDb();
+    try {
+        const result = db.prepare(`
+            INSERT INTO calendar_events (title, description, event_date, start_time, end_time, location, category)
+            VALUES (?, ?, ?, ?, ?, ?, ?)
+        `).run(title.trim(), description?.trim() || null, event_date, start_time || null,
+            end_time || null, location?.trim() || 'Galilee MBC', category || 'general');
+
+        logger.info(`Calendar event created: "${title}" on ${event_date} (ID: ${result.lastInsertRowid})`);
+        res.json({ success: true, id: result.lastInsertRowid });
+    } catch (err) {
+        logger.error('Error creating calendar event:', err);
+        res.status(500).json({ error: 'Failed to create event' });
+    }
+});
+
+// Update event
+router.put('/calendar/:id', requireAuth, (req, res) => {
+    const { title, description, event_date, start_time, end_time, location, category } = req.body;
+
+    const db = getDb();
+    try {
+        db.prepare(`
+            UPDATE calendar_events SET
+                title = COALESCE(?, title),
+                description = ?,
+                event_date = COALESCE(?, event_date),
+                start_time = ?,
+                end_time = ?,
+                location = ?,
+                category = COALESCE(?, category),
+                updated_at = datetime('now')
+            WHERE id = ?
+        `).run(title?.trim(), description?.trim() || null, event_date,
+            start_time || null, end_time || null, location?.trim() || 'Galilee MBC',
+            category, req.params.id);
+
+        logger.info(`Calendar event updated: ID ${req.params.id}`);
+        res.json({ success: true });
+    } catch (err) {
+        logger.error('Error updating calendar event:', err);
+        res.status(500).json({ error: 'Failed to update event' });
+    }
+});
+
+// Delete event
+router.delete('/calendar/:id', requireAuth, (req, res) => {
+    const db = getDb();
+    try {
+        db.prepare('DELETE FROM calendar_events WHERE id = ?').run(req.params.id);
+        logger.info(`Calendar event deleted: ID ${req.params.id}`);
+        res.json({ success: true });
+    } catch (err) {
+        logger.error('Error deleting calendar event:', err);
+        res.status(500).json({ error: 'Failed to delete event' });
+    }
+});
+
+// Upcoming events (for dashboard or public)
+router.get('/calendar/upcoming', requireAuth, (req, res) => {
+    const db = getDb();
+    const limit = parseInt(req.query.limit) || 5;
+    const today = new Date().toISOString().split('T')[0];
+
+    const events = db.prepare(
+        'SELECT * FROM calendar_events WHERE event_date >= ? ORDER BY event_date, start_time LIMIT ?'
+    ).all(today, limit);
+
+    res.json({ success: true, events });
+});
+
+// ==================== CHURCH MESSAGING API ====================
+
+// List church messages (inbox)
+router.get('/church-messages', requireAuth, (req, res) => {
+    const db = getDb();
+    const page = parseInt(req.query.page) || 1;
+    const limit = parseInt(req.query.limit) || 50;
+    const offset = (page - 1) * limit;
+    const filter = req.query.filter || 'all'; // all, broadcast, direct
+
+    let query = 'SELECT * FROM church_messages';
+    const params = [];
+
+    if (filter === 'broadcast') {
+        query += ' WHERE is_broadcast = 1';
+    } else if (filter === 'direct') {
+        query += ' WHERE is_broadcast = 0';
+    }
+
+    const total = db.prepare(query.replace('SELECT *', 'SELECT COUNT(*) as count')).get(...params).count;
+
+    query += ' ORDER BY created_at DESC LIMIT ? OFFSET ?';
+    params.push(limit, offset);
+
+    const messages = db.prepare(query).all(...params);
+
+    res.json({
+        success: true,
+        messages,
+        pagination: { page, limit, total, pages: Math.ceil(total / limit) }
+    });
+});
+
+// Send church message (direct or broadcast)
+router.post('/church-messages', requireAuth, async (req, res) => {
+    const { subject, body, recipient_ids, channel } = req.body;
+
+    if (!subject || !body) {
+        return res.status(400).json({ error: 'Subject and message body are required' });
+    }
+
+    const db = getDb();
+    const senderName = req.session.adminUsername;
+
+    try {
+        const isBroadcast = !recipient_ids || recipient_ids.length === 0;
+
+        if (isBroadcast) {
+            // Broadcast to all active members
+            const members = db.prepare('SELECT id, first_name, last_name FROM members WHERE is_active = 1').all();
+            const stmt = db.prepare(`
+                INSERT INTO church_messages (sender_name, recipient_id, recipient_name, subject, body, channel, is_broadcast)
+                VALUES (?, ?, ?, ?, ?, ?, 1)
+            `);
+            for (const m of members) {
+                stmt.run(senderName, m.id, `${m.first_name} ${m.last_name}`, subject, body, channel || 'internal');
+            }
+            logger.info(`Broadcast message sent: "${subject}" to ${members.length} members`);
+            res.json({ success: true, sent: members.length, type: 'broadcast' });
+        } else {
+            // Direct to selected members
+            const stmt = db.prepare(`
+                INSERT INTO church_messages (sender_name, recipient_id, recipient_name, subject, body, channel, is_broadcast)
+                VALUES (?, ?, ?, ?, ?, ?, 0)
+            `);
+            for (const id of recipient_ids) {
+                const member = db.prepare('SELECT first_name, last_name FROM members WHERE id = ?').get(id);
+                if (member) {
+                    stmt.run(senderName, id, `${member.first_name} ${member.last_name}`, subject, body, channel || 'internal');
+                }
+            }
+            logger.info(`Direct message sent: "${subject}" to ${recipient_ids.length} member(s)`);
+            res.json({ success: true, sent: recipient_ids.length, type: 'direct' });
+        }
+
+        // Also send via email/SMS if channel is not internal
+        if (channel === 'email' || channel === 'both') {
+            const memberIds = isBroadcast
+                ? db.prepare('SELECT id FROM members WHERE is_active = 1 AND email_subscribed = 1').all().map(m => m.id)
+                : recipient_ids;
+            try {
+                await sendManualMessage(subject, body, memberIds, 'email');
+            } catch (emailErr) {
+                logger.error('Error sending email for church message:', emailErr);
+            }
+        }
+    } catch (err) {
+        logger.error('Error sending church message:', err);
+        res.status(500).json({ error: 'Failed to send message' });
+    }
+});
+
+// Delete church message
+router.delete('/church-messages/:id', requireAuth, (req, res) => {
+    const db = getDb();
+    try {
+        db.prepare('DELETE FROM church_messages WHERE id = ?').run(req.params.id);
+        logger.info(`Church message deleted: ID ${req.params.id}`);
+        res.json({ success: true });
+    } catch (err) {
+        logger.error('Error deleting church message:', err);
+        res.status(500).json({ error: 'Failed to delete message' });
+    }
+});
