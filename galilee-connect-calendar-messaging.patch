+<script>
+    let calendarYear = new Date().getFullYear();
+    let calendarMonth = new Date().getMonth() + 1;
+
+    const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
+    const CATEGORY_COLORS = {
+        worship: { bg: 'bg-purple-100', text: 'text-purple-800', dot: '#4a1a6b' },
+        'bible-study': { bg: 'bg-blue-100', text: 'text-blue-800', dot: '#2563eb' },
+        youth: { bg: 'bg-orange-100', text: 'text-orange-800', dot: '#ea580c' },
+        fellowship: { bg: 'bg-green-100', text: 'text-green-800', dot: '#16a34a' },
+        meeting: { bg: 'bg-gray-100', text: 'text-gray-800', dot: '#6b7280' },
+        general: { bg: 'bg-yellow-100', text: 'text-yellow-800', dot: '#d4a843' }
+    };
+
+    document.addEventListener('DOMContentLoaded', () => loadCalendar());
+
+    function changeMonth(delta) {
+        calendarMonth += delta;
+        if (calendarMonth > 12) { calendarMonth = 1; calendarYear++; }
+        if (calendarMonth < 1) { calendarMonth = 12; calendarYear--; }
+        loadCalendar();
+    }
+
+    async function loadCalendar() {
+        document.getElementById('calendar-month-label').textContent = `${MONTH_NAMES[calendarMonth - 1]} ${calendarYear}`;
+
+        try {
+            const data = await apiCall(`/api/calendar?year=${calendarYear}&month=${calendarMonth}`);
+            renderCalendarGrid(data.events);
+            renderEventsTable(data.events);
+        } catch (err) {
+            document.getElementById('calendar-grid').innerHTML =
+                '<div class="col-span-7 p-8 text-center text-gray-400">Failed to load calendar</div>';
+        }
+    }
+
+    function renderCalendarGrid(events) {
+        const grid = document.getElementById('calendar-grid');
+        const firstDay = new Date(calendarYear, calendarMonth - 1, 1);
+        const daysInMonth = new Date(calendarYear, calendarMonth, 0).getDate();
+        const startDow = firstDay.getDay();
+        const today = new Date().toISOString().split('T')[0];
+
+        // Map events by day
+        const eventsByDay = {};
+        events.forEach(e => {
+            const day = parseInt(e.event_date.split('-')[2]);
+            if (!eventsByDay[day]) eventsByDay[day] = [];
+            eventsByDay[day].push(e);
+        });
+
+        let html = '';
+
+        // Empty cells before first day
+        for (let i = 0; i < startDow; i++) {
+            html += '<div class="border border-gray-50 p-2 min-h-[80px] bg-gray-50"></div>';
+        }
+
+        // Day cells
+        for (let day = 1; day <= daysInMonth; day++) {
+            const dateStr = `${calendarYear}-${String(calendarMonth).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
+            const isToday = dateStr === today;
+            const dayEvents = eventsByDay[day] || [];
+
+            html += `<div class="border border-gray-50 p-2 min-h-[80px] ${isToday ? 'bg-purple-50' : ''}">`;
+            html += `<div class="text-xs font-semibold ${isToday ? 'text-purple-700' : 'text-gray-500'} mb-1">${day}</div>`;
+
+            dayEvents.forEach(e => {
+                const cat = CATEGORY_COLORS[e.category] || CATEGORY_COLORS.general;
+                html += `<div class="text-xs ${cat.bg} ${cat.text} rounded px-1 py-0.5 mb-0.5 truncate cursor-pointer" onclick="editCalendarEvent(${e.id})" title="${escapeHtml(e.title)}">${escapeHtml(e.title)}</div>`;
+            });
+
+            html += '</div>';
+        }
+
+        grid.innerHTML = html;
+    }
+
+    function renderEventsTable(events) {
+        const tbody = document.getElementById('events-table-body');
+        if (events.length === 0) {
+            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">No events this month</td></tr>';
+            return;
+        }
+
+        tbody.innerHTML = events.map(e => {
+            const cat = CATEGORY_COLORS[e.category] || CATEGORY_COLORS.general;
+            const dateObj = new Date(e.event_date + 'T00:00:00');
+            const dateStr = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
+            const timeStr = e.start_time ? formatTime(e.start_time) + (e.end_time ? ' - ' + formatTime(e.end_time) : '') : '—';
+
+            return `
+                <tr class="border-b border-gray-100">
+                    <td class="px-4 py-3 text-gray-700">${dateStr}</td>
+                    <td class="px-4 py-3 font-medium text-gray-900">${escapeHtml(e.title)}</td>
+                    <td class="px-4 py-3 text-gray-600">${timeStr}</td>
+                    <td class="px-4 py-3 text-gray-600">${escapeHtml(e.location || '—')}</td>
+                    <td class="px-4 py-3"><span class="badge ${cat.bg} ${cat.text}">${e.category}</span></td>
+                    <td class="px-4 py-3">
+                        <div class="flex gap-2">
+                            <button onclick="editCalendarEvent(${e.id})" class="text-purple-700 hover:text-purple-900 text-sm font-medium">Edit</button>
+                            <button onclick="deleteCalendarEvent(${e.id}, '${escapeHtml(e.title)}')" class="text-red-500 hover:text-red-700 text-sm font-medium">Delete</button>
+                        </div>
+                    </td>
+                </tr>
+            `;
+        }).join('');
+    }
+
+    function formatTime(time) {
+        if (!time) return '';
+        const [h, m] = time.split(':');
+        const hr = parseInt(h);
+        const ampm = hr >= 12 ? 'PM' : 'AM';
+        const hr12 = hr === 0 ? 12 : hr > 12 ? hr - 12 : hr;
+        return `${hr12}:${m} ${ampm}`;
+    }
+
+    function showAddEventModal() {
+        showModal('Add Event', getEventFormHTML());
+    }
+
+    async function editCalendarEvent(id) {
+        try {
+            const data = await apiCall(`/api/calendar/${id}`);
+            showModal('Edit Event', getEventFormHTML(data.event));
+        } catch (err) {
+            showToast('Failed to load event', 'error');
+        }
+    }
+
+    async function saveCalendarEvent(event, id) {
+        event.preventDefault();
+        const form = event.target;
+        const body = {
+            title: form.title.value,
+            description: form.description.value,
+            event_date: form.event_date.value,
+            start_time: form.start_time.value,
+            end_time: form.end_time.value,
+            location: form.location.value,
+            category: form.category.value
+        };
+
+        try {
+            if (id) {
+                await apiCall(`/api/calendar/${id}`, { method: 'PUT', body });
+                showToast('Event updated');
+            } else {
+                await apiCall('/api/calendar', { method: 'POST', body });
+                showToast('Event created');
+            }
+            closeModal();
+            loadCalendar();
+        } catch (err) {}
+    }
+
+    async function deleteCalendarEvent(id, title) {
+        if (!confirm(`Delete "${title}"?`)) return;
+        try {
+            await apiCall(`/api/calendar/${id}`, { method: 'DELETE' });
+            showToast('Event deleted');
+            loadCalendar();
+        } catch (err) {}
+    }
+
+    function getEventFormHTML(event = null) {
+        const e = event || {};
+        return `
+            <form onsubmit="saveCalendarEvent(event, ${e.id || 'null'})">
+                <div class="mb-4">
+                    <label class="block text-sm font-medium text-gray-700 mb-1">Event Title *</label>
+                    <input type="text" name="title" value="${escapeHtml(e.title || '')}" required
+                        class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                </div>
+                <div class="grid grid-cols-2 gap-4 mb-4">
+                    <div>
+                        <label class="block text-sm font-medium text-gray-700 mb-1">Date *</label>
+                        <input type="date" name="event_date" value="${e.event_date || ''}" required
+                            class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                    </div>
+                    <div>
+                        <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
+                        <select name="category" class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                            <option value="worship" ${e.category === 'worship' ? 'selected' : ''}>Worship Service</option>
+                            <option value="bible-study" ${e.category === 'bible-study' ? 'selected' : ''}>Bible Study</option>
+                            <option value="youth" ${e.category === 'youth' ? 'selected' : ''}>Youth Ministry</option>
+                            <option value="fellowship" ${e.category === 'fellowship' ? 'selected' : ''}>Fellowship</option>
+                            <option value="meeting" ${e.category === 'meeting' ? 'selected' : ''}>Meeting</option>
+                            <option value="general" ${(!e.category || e.category === 'general') ? 'selected' : ''}>General</option>
+                        </select>
+                    </div>
+                </div>
+                <div class="grid grid-cols-2 gap-4 mb-4">
+                    <div>
+                        <label class="block text-sm font-medium text-gray-700 mb-1">Start Time</label>
+                        <input type="time" name="start_time" value="${e.start_time || ''}"
+                            class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                    </div>
+                    <div>
+                        <label class="block text-sm font-medium text-gray-700 mb-1">End Time</label>
+                        <input type="time" name="end_time" value="${e.end_time || ''}"
+                            class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                    </div>
+                </div>
+                <div class="mb-4">
+                    <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
+                    <input type="text" name="location" value="${escapeHtml(e.location || 'Galilee MBC')}"
+                        class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                </div>
+                <div class="mb-4">
+                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
+                    <textarea name="description" rows="3"
+                        class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">${escapeHtml(e.description || '')}</textarea>
+                </div>
+                <button type="submit" class="btn-primary w-full py-2.5 rounded-lg font-medium">
+                    ${e.id ? 'Update Event' : 'Create Event'}
+                </button>
+            </form>
+        `;
+    }
+</script>
