+
+    <!-- Mobile Header -->
+    <div class="md:hidden fixed top-0 left-0 right-0 bg-purple-900 text-white p-4 z-50 flex items-center justify-between">
+        <div class="flex items-center gap-2">
+            <span class="text-xl">✝</span>
+            <span class="font-display font-bold text-gold-400">Galilee Connect</span>
+        </div>
+        <div class="flex gap-3">
+            <a href="/admin" class="text-white text-sm">📊</a>
+            <a href="/admin/members" class="text-white text-sm">👥</a>
+            <a href="/admin/messages" class="text-white text-sm">✉️</a>
+            <a href="/admin/lessons" class="text-white text-sm">📖</a>
+            <a href="/admin/calendar" class="text-white text-sm">📅</a>
+            <a href="/admin/church-messages" class="text-white text-sm">💬</a>
+            <a href="/admin/logout" class="text-white text-sm">🚪</a>
+        </div>
+    </div>
+
+    <!-- Main Content -->
+    <main class="flex-1 p-6 md:p-8 md:mt-0 mt-16">
+        <div class="max-w-6xl mx-auto">
+            <!-- Header -->
+            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
+                <div>
+                    <h2 class="text-3xl font-display font-bold text-purple-900">Church Messages</h2>
+                    <p class="text-gray-500">Send direct or broadcast messages to members</p>
+                </div>
+                <div class="flex gap-3 mt-4 md:mt-0">
+                    <button onclick="showComposeModal()" class="btn-gold px-4 py-2 rounded-lg font-medium text-sm">
+                        + Compose Message
+                    </button>
+                </div>
+            </div>
+
+            <!-- Quick Actions -->
+            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
+                <div class="stat-card bg-white rounded-xl p-5 shadow-sm border border-gray-100 cursor-pointer" onclick="showComposeModal('broadcast')">
+                    <div class="text-3xl mb-2">📢</div>
+                    <div class="font-bold text-purple-900">Broadcast</div>
+                    <div class="text-sm text-gray-500">Send to all active members</div>
+                </div>
+                <div class="stat-card bg-white rounded-xl p-5 shadow-sm border border-gray-100 cursor-pointer" onclick="showComposeModal('direct')">
+                    <div class="text-3xl mb-2">👤</div>
+                    <div class="font-bold text-purple-900">Direct Message</div>
+                    <div class="text-sm text-gray-500">Send to specific members</div>
+                </div>
+                <div class="stat-card bg-white rounded-xl p-5 shadow-sm border border-gray-100 cursor-pointer" onclick="showComposeModal('email')">
+                    <div class="text-3xl mb-2">✉️</div>
+                    <div class="font-bold text-purple-900">Email Blast</div>
+                    <div class="text-sm text-gray-500">Send via email to all members</div>
+                </div>
+            </div>
+
+            <!-- Filter Tabs -->
+            <div class="flex gap-2 mb-4">
+                <button onclick="loadChurchMessages('all')" id="filter-all"
+                    class="px-4 py-2 rounded-lg text-sm font-medium bg-purple-700 text-white">All</button>
+                <button onclick="loadChurchMessages('broadcast')" id="filter-broadcast"
+                    class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">Broadcasts</button>
+                <button onclick="loadChurchMessages('direct')" id="filter-direct"
+                    class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">Direct</button>
+            </div>
+
+            <!-- Messages List -->
+            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
+                <div class="overflow-x-auto">
+                    <table class="data-table w-full text-sm">
+                        <thead>
+                            <tr>
+                                <th class="px-4 py-3 text-left">Date</th>
+                                <th class="px-4 py-3 text-left">From</th>
+                                <th class="px-4 py-3 text-left">To</th>
+                                <th class="px-4 py-3 text-left">Subject</th>
+                                <th class="px-4 py-3 text-left">Type</th>
+                                <th class="px-4 py-3 text-left">Actions</th>
+                            </tr>
+                        </thead>
+                        <tbody id="church-messages-body">
+                            <tr><td colspan="6" class="text-center py-8 text-gray-400">Loading...</td></tr>
+                        </tbody>
+                    </table>
+                </div>
+                <div id="church-messages-pagination" class="mt-4 flex justify-center gap-2"></div>
+            </div>
+        </div>
+    </main>
+</div>
+
+<script>
+    let currentFilter = 'all';
+    let currentPage = 1;
+
+    document.addEventListener('DOMContentLoaded', () => loadChurchMessages('all'));
+
+    async function loadChurchMessages(filter = 'all', page = 1) {
+        currentFilter = filter;
+        currentPage = page;
+
+        // Update filter button styles
+        ['all', 'broadcast', 'direct'].forEach(f => {
+            const btn = document.getElementById(`filter-${f}`);
+            if (f === filter) {
+                btn.className = 'px-4 py-2 rounded-lg text-sm font-medium bg-purple-700 text-white';
+            } else {
+                btn.className = 'px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200';
+            }
+        });
+
+        try {
+            const data = await apiCall(`/api/church-messages?filter=${filter}&page=${page}`);
+            renderChurchMessages(data.messages, data.pagination);
+        } catch (err) {
+            document.getElementById('church-messages-body').innerHTML =
+                '<tr><td colspan="6" class="text-center py-8 text-gray-400">Failed to load messages</td></tr>';
+        }
+    }
+
+    function renderChurchMessages(messages, pagination) {
+        const tbody = document.getElementById('church-messages-body');
+        if (messages.length === 0) {
+            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">No messages found</td></tr>';
+            document.getElementById('church-messages-pagination').innerHTML = '';
+            return;
+        }
+
+        tbody.innerHTML = messages.map(m => `
+            <tr class="border-b border-gray-100">
+                <td class="px-4 py-3 text-gray-500">${formatDate(m.created_at)}</td>
+                <td class="px-4 py-3 font-medium text-gray-900">${escapeHtml(m.sender_name)}</td>
+                <td class="px-4 py-3 text-gray-600">${m.is_broadcast ? '<span class="badge badge-info">All Members</span>' : escapeHtml(m.recipient_name || '—')}</td>
+                <td class="px-4 py-3 text-gray-700">${escapeHtml(m.subject)}</td>
+                <td class="px-4 py-3">
+                    <span class="badge ${m.is_broadcast ? 'badge-warning' : 'badge-success'}">
+                        ${m.is_broadcast ? '📢 Broadcast' : '👤 Direct'}
+                    </span>
+                </td>
+                <td class="px-4 py-3">
+                    <div class="flex gap-2">
+                        <button onclick="viewChurchMessage(${m.id}, '${escapeHtml(m.subject)}', '${escapeHtml(m.body)}', '${escapeHtml(m.sender_name)}', '${escapeHtml(m.recipient_name || 'All Members')}', '${m.created_at}')"
+                            class="text-purple-700 hover:text-purple-900 text-sm font-medium">View</button>
+                        <button onclick="deleteChurchMessage(${m.id})"
+                            class="text-red-500 hover:text-red-700 text-sm font-medium">Delete</button>
+                    </div>
+                </td>
+            </tr>
+        `).join('');
+
+        // Pagination
+        const pagDiv = document.getElementById('church-messages-pagination');
+        if (pagination.pages > 1) {
+            let pagHtml = '';
+            for (let p = 1; p <= pagination.pages; p++) {
+                pagHtml += `<button onclick="loadChurchMessages('${currentFilter}', ${p})"
+                    class="px-3 py-1 rounded text-sm ${p === pagination.page ? 'bg-purple-700 text-white' : 'bg-gray-100 text-gray-700'}">${p}</button>`;
+            }
+            pagDiv.innerHTML = pagHtml;
+        } else {
+            pagDiv.innerHTML = '';
+        }
+    }
+
+    function viewChurchMessage(id, subject, body, sender, recipient, date) {
+        const content = `
+            <div class="space-y-3">
+                <div class="flex justify-between text-sm text-gray-500">
+                    <span>From: <strong class="text-gray-700">${sender}</strong></span>
+                    <span>${formatDate(date)}</span>
+                </div>
+                <div class="text-sm text-gray-500">To: <strong class="text-gray-700">${recipient}</strong></div>
+                <div class="border-t border-gray-100 pt-3">
+                    <h4 class="font-bold text-gray-900 mb-2">${subject}</h4>
+                    <p class="text-gray-700 whitespace-pre-wrap">${body}</p>
+                </div>
+            </div>
+        `;
+        showModal('Message Details', content);
+    }
+
+    async function deleteChurchMessage(id) {
+        if (!confirm('Delete this message?')) return;
+        try {
+            await apiCall(`/api/church-messages/${id}`, { method: 'DELETE' });
+            showToast('Message deleted');
+            loadChurchMessages(currentFilter, currentPage);
+        } catch (err) {}
+    }
+
+    async function showComposeModal(type) {
+        let recipientSection = '';
+
+        if (type === 'direct') {
+            // Load members for selection
+            try {
+                const data = await apiCall('/api/members');
+                const options = data.members.map(m =>
+                    `<option value="${m.id}">${escapeHtml(m.first_name)} ${escapeHtml(m.last_name)}${m.email ? ' (' + escapeHtml(m.email) + ')' : ''}</option>`
+                ).join('');
+                recipientSection = `
+                    <div class="mb-4">
+                        <label class="block text-sm font-medium text-gray-700 mb-1">Recipients *</label>
+                        <select name="recipient_ids" multiple size="5"
+                            class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg">
+                            ${options}
+                        </select>
+                        <p class="text-xs text-gray-400 mt-1">Hold Ctrl/Cmd to select multiple members</p>
+                    </div>
+                `;
+            } catch (err) {
+                showToast('Failed to load members', 'error');
+                return;
+            }
+        } else if (type === 'broadcast') {
+            recipientSection = `
+                <div class="mb-4 bg-yellow-50 border border-yellow-200 rounded-lg p-3">
+                    <p class="text-sm text-yellow-800">📢 This message will be sent to <strong>all active members</strong>.</p>
+                </div>
+            `;
+        } else if (type === 'email') {
+            recipientSection = `
+                <div class="mb-4 bg-blue-50 border border-blue-200 rounded-lg p-3">
+                    <p class="text-sm text-blue-800">✉️ This message will be emailed to all email-subscribed members.</p>
+                </div>
+                <input type="hidden" name="channel" value="email">
+            `;
+        }
+
+        const content = `
+            <form onsubmit="sendChurchMessage(event, '${type || 'direct'}')">
+                ${recipientSection}
+                <div class="mb-4">
+                    <label class="block text-sm font-medium text-gray-700 mb-1">Subject *</label>
+                    <input type="text" name="subject" required
+                        class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg"
+                        placeholder="Message subject">
+                </div>
+                <div class="mb-4">
+                    <label class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
+                    <textarea name="body" rows="6" required
+                        class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg"
+                        placeholder="Type your message here..."></textarea>
+                </div>
+                <button type="submit" class="btn-primary w-full py-2.5 rounded-lg font-medium">
+                    Send Message
+                </button>
+            </form>
+        `;
+
+        const titles = { broadcast: 'Broadcast Message', direct: 'Direct Message', email: 'Email Blast' };
+        showModal(titles[type] || 'Compose Message', content);
+    }
+
+    async function sendChurchMessage(event, type) {
+        event.preventDefault();
+        const form = event.target;
+
+        const body = {
+            subject: form.subject.value,
+            body: form.body.value,
+            channel: form.channel ? form.channel.value : 'internal'
+        };
+
+        if (type === 'direct') {
+            const select = form.querySelector('[name="recipient_ids"]');
+            body.recipient_ids = Array.from(select.selectedOptions).map(o => parseInt(o.value));
+            if (body.recipient_ids.length === 0) {
+                showToast('Please select at least one recipient', 'error');
+                return;
+            }
+        } else if (type === 'email') {
+            body.channel = 'email';
+        }
+
+        try {
+            const result = await apiCall('/api/church-messages', { method: 'POST', body });
+            showToast(`Message sent to ${result.sent} member(s)`);
+            closeModal();
+            loadChurchMessages(currentFilter, currentPage);
+        } catch (err) {}
+    }
+</script>
