<div class="container">
  <div class="admin-header">
    <h1>Admin Dashboard</h1>
    <p class="text-muted">Welcome back, <%= user.full_name %></p>
  </div>

  <div class="admin-nav">
    <a href="/admin" class="admin-nav-item active">Dashboard</a>
    <a href="/admin/calendar" class="admin-nav-item">Calendar</a>
    <a href="/admin/church-messages" class="admin-nav-item">Church Messages</a>
    <a href="/admin/members" class="admin-nav-item">Members</a>
  </div>

  <div class="admin-stats">
    <div class="stat-card">
      <span class="stat-number"><%= memberCount %></span>
      <span class="stat-label">Members</span>
    </div>
    <div class="stat-card">
      <span class="stat-number"><%= upcomingEvents.length %></span>
      <span class="stat-label">Upcoming Events</span>
    </div>
    <div class="stat-card">
      <span class="stat-number"><%= churchMessages.length %></span>
      <span class="stat-label">Recent Messages</span>
    </div>
  </div>

  <div class="admin-grid">
    <div class="card">
      <h2>Upcoming Events</h2>
      <% if (upcomingEvents.length === 0) { %>
        <p class="text-muted">No upcoming events.</p>
      <% } else { %>
        <ul class="admin-list">
          <% upcomingEvents.forEach(event => { %>
            <li>
              <strong><%= event.title %></strong>
              <span class="event-date">
                <%= new Date(event.event_date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                <% if (event.start_time) { %> at <%= event.start_time %><% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <a href="/admin/calendar" class="btn btn-outline" style="margin-top: 1rem;">Manage Calendar</a>
    </div>

    <div class="card">
      <h2>Recent Church Messages</h2>
      <% if (churchMessages.length === 0) { %>
        <p class="text-muted">No messages posted yet.</p>
      <% } else { %>
        <ul class="admin-list">
          <% churchMessages.forEach(msg => { %>
            <li>
              <% if (msg.pinned) { %><span class="pin-icon">&#128204;</span><% } %>
              <strong><%= msg.title %></strong>
              <span class="msg-cat cat-badge-<%= msg.category %>"><%= msg.category %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <a href="/admin/church-messages" class="btn btn-outline" style="margin-top: 1rem;">Manage Messages</a>
    </div>
  </div>
</div>
