<div class="container">
  <div class="admin-header">
    <h1>Members</h1>
    <p class="text-muted"><%= members.length %> registered members</p>
  </div>

  <div class="admin-nav">
    <a href="/admin" class="admin-nav-item">Dashboard</a>
    <a href="/admin/calendar" class="admin-nav-item">Calendar</a>
    <a href="/admin/church-messages" class="admin-nav-item">Church Messages</a>
    <a href="/admin/lessons" class="admin-nav-item">Lessons</a>
    <a href="/admin/members" class="admin-nav-item active">Members</a>
  </div>

  <div class="card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Username</th>
          <th>Role</th>
        </tr>
      </thead>
      <tbody>
        <% members.forEach(member => { %>
          <tr>
            <td><strong><%= member.full_name %></strong></td>
            <td><%= member.username %></td>
            <td><span class="role-badge role-<%= member.role %>"><%= member.role %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
