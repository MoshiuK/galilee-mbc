<div class="container">
  <a href="/calendar" class="back-link">&larr; Back to Calendar</a>

  <div class="card event-detail">
    <span class="category-badge cat-<%= event.category %>"><%= event.category %></span>
    <h1><%= event.title %></h1>

    <div class="event-meta">
      <p><strong>Date:</strong> <%= new Date(event.event_date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      <% if (event.start_time) { %>
        <p><strong>Time:</strong> <%= event.start_time %><%= event.end_time ? ' – ' + event.end_time : '' %></p>
      <% } %>
      <p><strong>Location:</strong> <%= event.location %></p>
      <% if (event.creator_name) { %>
        <p><strong>Posted by:</strong> <%= event.creator_name %></p>
      <% } %>
    </div>

    <% if (event.description) { %>
      <div class="event-description">
        <p><%= event.description %></p>
      </div>
    <% } %>

    <% if (user && (user.role === 'admin' || user.role === 'pastor')) { %>
      <div class="event-actions">
        <a href="/calendar/event/<%= event.id %>/edit" class="btn btn-outline">Edit</a>
        <form method="POST" action="/calendar/event/<%= event.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this event?')">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% } %>
  </div>
</div>
