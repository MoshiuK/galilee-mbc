<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Galilee MBC</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-brand">Galilee MBC</a>
      <div class="nav-links">
        <a href="/calendar">Calendar</a>
        <% if (user) { %>
          <a href="/messages">
            Messages
            <% if (unreadCount > 0) { %>
              <span class="badge"><%= unreadCount %></span>
            <% } %>
          </a>
          <span class="nav-user">Hi, <%= user.full_name.split(' ')[0] %></span>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <% if (flash) { %>
    <div class="container">
      <div class="flash flash-<%= flash.type %>">
        <%= flash.message %>
      </div>
    </div>
  <% } %>

  <main>
    <% if (typeof body === 'string') { %>
      <%- body %>
    <% } else { %>
      <%- include(view) %>
    <% } %>
  </main>

  <footer class="footer">
    <div class="container">
      <p>Galilee Missionary Baptist Church &mdash; Florence, Alabama</p>
      <p>Pastor Moshiu T. Knox</p>
    </div>
  </footer>
</body>
</html>
